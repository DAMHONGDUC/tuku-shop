# What this app is, and nothing else. The lanes live in script-tools:
#
#   bundle exec fastlane certificates          # local only, once
#   bundle exec fastlane preflight             # checks, no build
#   bundle exec fastlane beta flavor:dev bump:true notes:"..."
#   bundle exec fastlane upload flavor:dev     # a built IPA that failed to upload
#
# From the project root these are `make release-ios-<flavor>` and friends.
# Nothing here archives: `packages/script-tools/flutter/build_ipa.sh` does.
import "../../packages/script-tools/flutter/fastlane/Fastfile"

# `targets` is ordered; the first is the app and the bundle id every upload
# uses. An extension added later goes here AND in the Matchfile.
sd_ios_app(
  team_id: "WNG5UWNJ6H",
  targets: [
    { name: "Runner", bundle_id: "app.dd.tuku.shop" },
  ],
)
